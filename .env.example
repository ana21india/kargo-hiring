# Neon Postgres connection string (from the Neon dashboard, starts with postgresql://)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# These stay server-side only — never prefix with VITE_
GEMINI_API_KEY=AQ....
# Gmail SMTP sending — generate an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account). No domain needed, sends to any recipient.
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
MAIL_FROM_NAME=Kargo Hiring Team
ARJUN_EMAIL=ananta_khandelwal@pg27.mesaschool.co

# App (the Express dev server's port — kept distinct from Vite's port/PORT)
API_PORT=3001
