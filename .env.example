# Neon Postgres connection string (from the Neon dashboard, starts with postgresql://)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# These stay server-side only — never prefix with VITE_
GEMINI_API_KEY=AQ....
RESEND_API_KEY=re_...
RESEND_FROM=onboarding@resend.dev
ARJUN_EMAIL=ananta_khandelwal@pg27.mesaschool.co

# App (the Express dev server's port — kept distinct from Vite's port/PORT)
API_PORT=3001
